      "requirement_type": "DOMAIN_ACTION",
      "criticality": "CORE",
      "provenance": {
        "source_file": "tasks/visual_creation_task6/instruction.md",
        "source_type": "instruction",
        "line_start": 3,
        "line_end": 3,
        "exact_text": "Create index.html with full-screen sections for each chapter, smooth scrolling with layered depth effects, text animations that reveal content as you scroll, a progress indicator bar, and responsive design for different screen sizes.",
