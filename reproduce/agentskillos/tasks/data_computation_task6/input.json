      "requirement_type": "DOMAIN_ACTION",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/data_computation_task6/instruction.md",
        "source_type": "instruction",
        "line_start": 6,
        "line_end": 7,
        "exact_text": "4. $\\int_0^{\\pi/2} \\sqrt{\\sin(x)}\\,dx$\n\n",
        "source_sha256": "0af00699e3d7bb12d30352e0a7ba782c494cdaed8a4a3ba7a839dcb3459573ec",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_fb9e8c784df826f895ac",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "CORE",
      "provenance": {
        "source_file": "tasks/data_computation_task6/instruction.md",
        "source_type": "instruction",
        "line_start": 8,
        "line_end": 8,
        "exact_text": "For each integral, apply 3 numerical methods (Trapezoidal rule N=100, Simpson's rule N=100, Gaussian quadrature) and compute the numerical approximation and error.\n",
        "source_sha256": "0af00699e3d7bb12d30352e0a7ba782c494cdaed8a4a3ba7a839dcb3459573ec",
        "extraction_rule": "actionable_paragraph"
      }
    },
    {
      "requirement_id": "req_b531c63e645ce6a7a8ef",
      "requirement_type": "OUTPUT_PATH",
      "criticality": "HARD",
      "provenance": {
        "source_file": "tasks/data_computation_task6/instruction.md",
        "source_type": "instruction",
        "line_start": 10,
        "line_end": 10,
        "exact_text": "Output integrals.json as a JSON object with an \"integrals\" key containing an array of 4 objects, i.e. {\"integrals\": [...]}, each object containing integral_id, integrand, bounds, exact_numeric, trapezoidal, simpson, gaussian_quadrature, and the error for each method.\n",
        "source_sha256": "0af00699e3d7bb12d30352e0a7ba782c494cdaed8a4a3ba7a839dcb3459573ec",
        "extraction_rule": "actionable_paragraph"
      }
    },
    {
