        "line_start": 1,
        "line_end": 1,
        "exact_text": "I am a numerical analysis student, and I need to complete a coursework project comparing numerical integration methods. Please compute the symbolic and numerical solutions for the following 4 definite integrals, and generate visualizations:\n",
        "source_sha256": "0af00699e3d7bb12d30352e0a7ba782c494cdaed8a4a3ba7a839dcb3459573ec",
        "extraction_rule": "actionable_paragraph"
      }
    },
    {
      "requirement_id": "req_65be5909829f2a55a6c5",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/data_computation_task6/instruction.md",
        "source_type": "instruction",
        "line_start": 3,
        "line_end": 3,
        "exact_text": "1. $\\int_0^{\\pi} \\sin(x)\\,dx$\n",
        "source_sha256": "0af00699e3d7bb12d30352e0a7ba782c494cdaed8a4a3ba7a839dcb3459573ec",
        "extraction_rule": "commonmark_list_item"
