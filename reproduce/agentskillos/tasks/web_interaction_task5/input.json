  "requirements": [
    {
      "requirement_id": "req_53e3a90870e00245f25d",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "CORE",
      "provenance": {
        "source_file": "tasks/web_interaction_task5/instruction.md",
        "source_type": "instruction",
        "line_start": 1,
        "line_end": 1,
        "exact_text": "You are a Python technical documentation engineer responsible for maintaining your team's internal knowledge base. You need to build an automated pipeline to collect Python built-in function information from the official documentation and generate standardized reports.\n",
        "source_sha256": "a90947cb47c605fd96fbf43ebd7e788fe13b796966c46a482fd9f1a861aea8e2",
        "extraction_rule": "actionable_paragraph"
      }
    },
    {
      "requirement_id": "req_98c93bc9e34cba0cc129",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "CORE",
      "provenance": {
        "source_file": "tasks/web_interaction_task5/instruction.md",
        "source_type": "instruction",
        "line_start": 5,
        "line_end": 6,
        "exact_text": "1. Visit the Python official documentation's built-in functions page (https://docs.python.org/3/library/functions.html) and extract the name and description (first sentence of the docstring) of every built-in function listed on the page.\n\n",
        "source_sha256": "a90947cb47c605fd96fbf43ebd7e788fe13b796966c46a482fd9f1a861aea8e2",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_d9a76a0b0accb1f5e87e",
      "requirement_type": "FORMAT",
      "criticality": "CORE",
      "provenance": {
        "source_file": "tasks/web_interaction_task5/instruction.md",
        "source_type": "instruction",
        "line_start": 7,
        "line_end": 11,
        "exact_text": "2. Generate builtin_functions.json as a JSON object with the following fields:\n   - \"source\": the URL of the page you scraped (string)\n   - \"total_count\": the total number of functions collected (integer)\n   - \"functions\": an array of objects, each containing \"name\" (function name) and \"description\" (brief description), sorted alphabetically by name\n\n",
        "source_sha256": "a90947cb47c605fd96fbf43ebd7e788fe13b796966c46a482fd9f1a861aea8e2",
        "extraction_rule": "commonmark_list_item"
      }
    },
