      "criticality": "CORE",
      "provenance": {
        "source_file": "tasks/mhc-layer-impl/instruction.md",
        "source_type": "instruction",
        "line_start": 3,
        "line_end": 3,
        "exact_text": "The training using A100 GPU from modal(https://modal.com/) on Fineweb dataset, baseline model provided in /root/src (data, model, train.py). Your task is to implement the mHC layer during training process as described in the paper, then train both baseline and mHC model till validation loss < 4.5 or 5000 steps.\n",
        "source_sha256": "fb31b6b3013a8765e5a7ca2d2a3b9a2d799beaff2a1715881c4a712644bb2907",
        "extraction_rule": "actionable_paragraph"
