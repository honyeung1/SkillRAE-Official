        "source_type": "instruction",
        "line_start": 24,
        "line_end": 24,
        "exact_text": "- output data should has same column amount as the input data\r\n",
        "source_sha256": "e189c11747388583e83ff0e508fe315ea26be21c46e0a143dd5ec3ac24fb4c36",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
