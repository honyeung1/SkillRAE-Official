        "source_type": "instruction",
        "line_start": 40,
        "line_end": 40,
        "exact_text": "2. The long pauses (usually > 2 sec) need to be removed.\n",
        "source_sha256": "c28df4425efeb4de26e14df907e76946d6b408efe1a0081be96d20d2bbd12abf",
        "extraction_rule": "commonmark_list_item"
