      "requirement_type": "DOMAIN_ACTION",
      "criticality": "HARD",
      "provenance": {
        "source_file": "tasks/manufacturing-equipment-maintenance/instruction.md",
        "source_type": "instruction",
        "line_start": 70,
        "line_end": 70,
        "exact_text": "Question 5: Select the best run per board_family based on quality and efficiency, and list other run_ids in runner_up_run_ids. Do not hallucinate or guess values.\n",
        "source_sha256": "4b104d47845c15a8fca383ab00242a0a39c534c6a205950ae6b3c9fb0a228d90",
        "extraction_rule": "actionable_paragraph"
