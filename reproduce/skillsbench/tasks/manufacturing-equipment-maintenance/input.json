        "line_start": 57,
        "line_end": 57,
        "exact_text": "You are required to generate /app/output/q04.json. Please follow the following format. Round float values to 2 decimals. Sort arrays by run_id or board_family or board_id ascending. Use null if necessary.\n",
        "source_sha256": "4b104d47845c15a8fca383ab00242a0a39c534c6a205950ae6b3c9fb0a228d90",
