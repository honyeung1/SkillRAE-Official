        "source_type": "instruction",
        "line_start": 6,
        "line_end": 6,
        "exact_text": "2. Compare it with the current Excel file.\n",
        "source_sha256": "990b86210784fa087b8adc7e09a7d1e95175aa925e30f0646a9613c3525165e2",
        "extraction_rule": "commonmark_list_item"
