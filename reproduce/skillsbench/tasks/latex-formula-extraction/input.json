        "line_start": 10,
        "line_end": 10,
        "exact_text": "4. Remove tags, commas, or periods in the end of formulas\n",
        "source_sha256": "6606722dbc34e1ba3a6c9d5afc5cec8a6ee50d2869e1b1e4d0f218edaf5b2ed6",
        "extraction_rule": "commonmark_list_item"
