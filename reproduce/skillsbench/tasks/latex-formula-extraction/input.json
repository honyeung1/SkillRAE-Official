        "line_end": 8,
        "exact_text": "2. Extract them as raw latex text string using `$$ ... $$` method, and make sure they can be properly rendered exactly same as original pdf display\n",
        "source_sha256": "6606722dbc34e1ba3a6c9d5afc5cec8a6ee50d2869e1b1e4d0f218edaf5b2ed6",
        "extraction_rule": "commonmark_list_item"
