      "criticality": "HARD",
      "provenance": {
        "source_file": "tasks/flink-query/instruction.md",
        "source_type": "instruction",
        "line_start": 10,
        "line_end": 10,
        "exact_text": "A stage is defined as a period of task SUBMIT events that occur close to each other in event time for a given job. A stage ends when there is an inactivity period of 10 minutes with no SUBMIT events for that job.  \n",
        "source_sha256": "7b48140e4198503de244e782199b16245542deb5602df2197525ea210303b01e",
        "extraction_rule": "actionable_paragraph"
      }
    },
