{
  "task_id": "travel-planning",
  "top_k": 5,
  "requirements": [
    {
      "requirement_id": "req_b884130def90314463c8",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "CORE",
      "provenance": {
        "source_file": "tasks/travel-planning/instruction.md",
        "source_type": "instruction",
        "line_start": 2,
        "line_end": 3,
        "exact_text": "Build an itinerary for the user according to the following requirements:\n\"We require a 7-day travel itinerary for two leaving from Minneapolis and covering three cities in Ohio, starting from March 17th to March 23rd, 2022. Our budget is up to $5,100. We will be accompanied by our pets, so we need pet-friendly accommodations. Our meals should preferably include American, Mediterranean, Chinese, and Italian cuisines. Please note we prefer not to take any flights so our travel plan should not include them.\"\n",
        "source_sha256": "c67d0b8304c30c1b584080f3572967595acdbede0cca51a7e7713f455b142661",
        "extraction_rule": "actionable_paragraph"
      }
    },
    {
      "requirement_id": "req_676b252d40dda54fdfed",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "HARD",
      "provenance": {
        "source_file": "tasks/travel-planning/instruction.md",
        "source_type": "instruction",
        "line_start": 6,
        "line_end": 7,
        "exact_text": "- You must utilize skills to search for real-world data in the database, do not use data/POIs from your memory.\n\n",
        "source_sha256": "c67d0b8304c30c1b584080f3572967595acdbede0cca51a7e7713f455b142661",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_a3187cb5b196ee8cee1d",
      "requirement_type": "OUTPUT_PATH",
      "criticality": "HARD",
      "provenance": {
        "source_file": "tasks/travel-planning/instruction.md",
        "source_type": "instruction",
        "line_start": 10,
        "line_end": 10,
        "exact_text": "Produce a single JSON file to `/app/output/itinerary.json` with the following structure:\n",
        "source_sha256": "c67d0b8304c30c1b584080f3572967595acdbede0cca51a7e7713f455b142661",
        "extraction_rule": "actionable_paragraph"
      }
    },
    {
      "requirement_id": "req_d8bd6a66107d7cee8b82",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/travel-planning/instruction.md",
        "source_type": "instruction",
        "line_start": 13,
        "line_end": 13,
        "exact_text": "- `plan`: array of exactly 7 day objects (see below)\n",
        "source_sha256": "c67d0b8304c30c1b584080f3572967595acdbede0cca51a7e7713f455b142661",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_7f46b0f2d684e2f154bc",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/travel-planning/instruction.md",
        "source_type": "instruction",
        "line_start": 14,
        "line_end": 15,
        "exact_text": "- `tool_called`: array of strings listing all search skills used (e.g., `[\"search_cities\", \"search_accommodations\", ...]`)\n\n",
        "source_sha256": "c67d0b8304c30c1b584080f3572967595acdbede0cca51a7e7713f455b142661",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_6c66e0949dcfbac3c010",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "HARD",
      "provenance": {
        "source_file": "tasks/travel-planning/instruction.md",
        "source_type": "instruction",
        "line_start": 16,
        "line_end": 16,
        "exact_text": "**Each day object in `plan` must contain:**\n",
        "source_sha256": "c67d0b8304c30c1b584080f3572967595acdbede0cca51a7e7713f455b142661",
        "extraction_rule": "actionable_paragraph"
      }
    },
    {
      "requirement_id": "req_17d24610258225d1f5a4",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/travel-planning/instruction.md",
        "source_type": "instruction",
        "line_start": 17,
        "line_end": 17,
        "exact_text": "- `day`: integer day number (1–7)\n",
        "source_sha256": "c67d0b8304c30c1b584080f3572967595acdbede0cca51a7e7713f455b142661",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_8aa18016e7d80fcf1236",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/travel-planning/instruction.md",
        "source_type": "instruction",
        "line_start": 18,
        "line_end": 18,
        "exact_text": "- `current_city`: string (city name, or `\"from A to B\"` when moving between cities)\n",
        "source_sha256": "c67d0b8304c30c1b584080f3572967595acdbede0cca51a7e7713f455b142661",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_6df8effb838ddd3d59f5",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "HARD",
      "provenance": {
        "source_file": "tasks/travel-planning/instruction.md",
        "source_type": "instruction",
        "line_start": 19,
        "line_end": 19,
        "exact_text": "- `transportation`: string (e.g., `\"Self-driving: from A to B\"`; do not use flights)\n",
        "source_sha256": "c67d0b8304c30c1b584080f3572967595acdbede0cca51a7e7713f455b142661",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_19f416bb599931f86b02",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/travel-planning/instruction.md",
        "source_type": "instruction",
        "line_start": 20,
        "line_end": 20,
        "exact_text": "- `breakfast`, `lunch`, `dinner`: string; use `\"-\"` if intentionally skipped\n",
        "source_sha256": "c67d0b8304c30c1b584080f3572967595acdbede0cca51a7e7713f455b142661",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_f17222b7790a2cc453fd",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/travel-planning/instruction.md",
        "source_type": "instruction",
        "line_start": 21,
        "line_end": 21,
        "exact_text": "- `attraction`: string; list multiple attractions separated by `;` and end with `;` (e.g., `\"Rock & Roll Hall of Fame;West Side Market;\"`)\n",
        "source_sha256": "c67d0b8304c30c1b584080f3572967595acdbede0cca51a7e7713f455b142661",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_94cfda413f9046a79d28",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/travel-planning/instruction.md",
        "source_type": "instruction",
        "line_start": 22,
        "line_end": 23,
        "exact_text": "- `accommodation`: string; pet-friendly lodging\n\n",
        "source_sha256": "c67d0b8304c30c1b584080f3572967595acdbede0cca51a7e7713f455b142661",
        "extraction_rule": "commonmark_list_item"
      }
    }
