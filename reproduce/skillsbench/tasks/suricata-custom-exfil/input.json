  "task_id": "suricata-custom-exfil",
  "top_k": 5,
  "requirements": [
    {
      "requirement_id": "req_312629e7ef71a27ec1b9",
      "requirement_type": "OUTPUT_PATH",
      "criticality": "HARD",
      "provenance": {
        "source_file": "tasks/suricata-custom-exfil/instruction.md",
        "source_type": "instruction",
        "line_start": 5,
        "line_end": 7,
        "exact_text": "The custom exfil pattern should alert only when all of the following are true:(1)HTTP `POST` request\n(2)Request path is exactly /telemetry/v2/report (3)Request header contains `X-TLM-Mode: exfil`\n(4)Body has blob= with a Base64-looking value ≥ 80 chars, and (5)Body has `sig=` with exactly 64 hex chars\n",
        "source_sha256": "651a57498887c43568d14daafecd31b583705f6460652efc311eb20ecd488fb7",
        "extraction_rule": "actionable_paragraph"
      }
    },
    {
      "requirement_id": "req_ed951d4fd86f9186568a",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "CORE",
      "provenance": {
        "source_file": "tasks/suricata-custom-exfil/instruction.md",
        "source_type": "instruction",
        "line_start": 11,
        "line_end": 11,
        "exact_text": "You need to update `/root/local.rules` so that Suricata raises an alert with `sid:1000001` for true exfil traffic.\n",
        "source_sha256": "651a57498887c43568d14daafecd31b583705f6460652efc311eb20ecd488fb7",
        "extraction_rule": "actionable_paragraph"
      }
