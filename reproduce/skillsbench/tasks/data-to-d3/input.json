    {
      "requirement_id": "req_53d605837d3b560eb26a",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "HARD",
      "provenance": {
        "source_file": "tasks/data-to-d3/instruction.md",
        "source_type": "instruction",
        "line_start": 10,
        "line_end": 16,
        "exact_text": "- A bubble chart where each bubble maps to one stock:\n   1. The bubbles should be sized by market capitalization (use larger bubble for larger market cap). ETFs don't have market cap data, so size them uniformly\n   2. The bubbles should be colored by their corresponding sector, positioned by D3.js force simulation for clusters by sector: bubbles belonging to the same sector should be close together and organized into the same cluster by using forceX/forceY. Add legends to show the sector name of each color.\n   3. The clusters for each sector should be close together and centered reasonably in the chart (not scattered far away).\n   4. Use forceCollide to make sure there's no overlap of bubbles.\n   5. Each bubble should be labeled by its ticker symbol inside\n   6. When I hover over bubbles, it should show a tooltip with the bubble's ticker, name, and sector. (Note: ETF entries have no marketCap, country, or website data, so do not show tooltip for them)\n",
        "source_sha256": "aeafcc631780e7258af753222f19fa0a0cd7f03fa795c47a773b739b33b04809",
        "extraction_rule": "commonmark_list_item"
      }
    },
