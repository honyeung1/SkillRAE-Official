        "source_type": "instruction",
        "line_start": 19,
        "line_end": 22,
        "exact_text": "5. Write the result to `/root/answer.txt`:\n   - Output only the correlation coefficient as a single number\n   - Round to 5 decimal places\n\n",
        "source_sha256": "1fe2602584cfb22f85357185f41a215f090deacc3fe7e730d15c5db4fc4496db",
        "extraction_rule": "commonmark_list_item"
