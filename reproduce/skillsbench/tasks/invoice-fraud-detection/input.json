{
  "task_id": "invoice-fraud-detection",
  "top_k": 5,
  "requirements": [
    {
      "requirement_id": "req_24d2fef3b3cfef0e5e15",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "CORE",
      "provenance": {
        "source_file": "tasks/invoice-fraud-detection/instruction.md",
        "source_type": "instruction",
        "line_start": 1,
        "line_end": 1,
        "exact_text": "You need to analyze the following files to find any potential invoice fraud:\n",
        "source_sha256": "72cdeb34c90fc050458ad80f8049de3351fb3eeaeeb8071e5c9bbc51532c8d6d",
        "extraction_rule": "actionable_paragraph"
      }
    },
    {
      "requirement_id": "req_3e9f0c78651ee03f3d3c",
      "requirement_type": "FORMAT",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/invoice-fraud-detection/instruction.md",
        "source_type": "instruction",
        "line_start": 2,
        "line_end": 2,
        "exact_text": "- `/root/invoices.pdf`: One invoice per page.\n",
        "source_sha256": "72cdeb34c90fc050458ad80f8049de3351fb3eeaeeb8071e5c9bbc51532c8d6d",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_8c62e07eaed7fa133a45",
      "requirement_type": "FORMAT",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/invoice-fraud-detection/instruction.md",
        "source_type": "instruction",
        "line_start": 3,
        "line_end": 3,
        "exact_text": "- `/root/vendors.xlsx`: Approved vendors with corresponding Vendor ID, Name, and authorized IBAN.\n",
        "source_sha256": "72cdeb34c90fc050458ad80f8049de3351fb3eeaeeb8071e5c9bbc51532c8d6d",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_1778b7c33765b9423c83",
      "requirement_type": "FORMAT",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/invoice-fraud-detection/instruction.md",
        "source_type": "instruction",
        "line_start": 4,
        "line_end": 5,
        "exact_text": "- `/root/purchase_orders.csv`: Valid purchase orders with corresponding PO Number, Amount, and Vendor ID.\n\n",
        "source_sha256": "72cdeb34c90fc050458ad80f8049de3351fb3eeaeeb8071e5c9bbc51532c8d6d",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_c2cecec1ff48726790b3",
      "requirement_type": "FORMAT",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/invoice-fraud-detection/instruction.md",
        "source_type": "instruction",
        "line_start": 7,
        "line_end": 7,
        "exact_text": "- Unknown Vendor: The vendor name doesn't exist in `vendors.xlsx`. Vendor names can have minor typos or variations, such as \"Ltd\" vs. \"Limited\". To handle this, you can use fuzzy matching.\n",
        "source_sha256": "72cdeb34c90fc050458ad80f8049de3351fb3eeaeeb8071e5c9bbc51532c8d6d",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_3f9fc7711ecbbe92d208",
      "requirement_type": "CONSISTENCY",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/invoice-fraud-detection/instruction.md",
        "source_type": "instruction",
        "line_start": 8,
        "line_end": 8,
        "exact_text": "- IBAN Mismatch: The vendor exists, but the invoice IBAN doesn't match the one of the vendor.\n",
        "source_sha256": "72cdeb34c90fc050458ad80f8049de3351fb3eeaeeb8071e5c9bbc51532c8d6d",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_1a772652f3bf790f9b65",
      "requirement_type": "FORMAT",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/invoice-fraud-detection/instruction.md",
        "source_type": "instruction",
        "line_start": 9,
        "line_end": 9,
        "exact_text": "- Invalid PO: The PO number doesn't exist in `purchase_orders.csv`.\n",
        "source_sha256": "72cdeb34c90fc050458ad80f8049de3351fb3eeaeeb8071e5c9bbc51532c8d6d",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_e9e6388f67d83d22c11c",
      "requirement_type": "CONSISTENCY",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/invoice-fraud-detection/instruction.md",
        "source_type": "instruction",
        "line_start": 10,
        "line_end": 10,
        "exact_text": "- Amount Mismatch: The PO exists, but the amount doesn't match the one of the invoice, which exceeds a 0.01 difference.\n",
        "source_sha256": "72cdeb34c90fc050458ad80f8049de3351fb3eeaeeb8071e5c9bbc51532c8d6d",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_cd1c23911a51f832dc69",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/invoice-fraud-detection/instruction.md",
        "source_type": "instruction",
        "line_start": 11,
        "line_end": 12,
        "exact_text": "- Vendor Mismatch: The PO is valid, but it is linked to a different Vendor ID than the one on the invoice.\n\n",
        "source_sha256": "72cdeb34c90fc050458ad80f8049de3351fb3eeaeeb8071e5c9bbc51532c8d6d",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_1d365d8a9419902e2ea2",
      "requirement_type": "OUTPUT_PATH",
      "criticality": "HARD",
      "provenance": {
        "source_file": "tasks/invoice-fraud-detection/instruction.md",
        "source_type": "instruction",
        "line_start": 13,
        "line_end": 13,
        "exact_text": "Save the findings to `/root/fraud_report.json`. Only include flagged invoices. Use 1-based page indexing. If the PO is missing, set it to `null`. Set the reason to one of the above criteria. If multiple apply, pick the first one in the order listed above.\n",
        "source_sha256": "72cdeb34c90fc050458ad80f8049de3351fb3eeaeeb8071e5c9bbc51532c8d6d",
        "extraction_rule": "actionable_paragraph"
      }
