      "requirement_type": "OUTPUT_PATH",
      "criticality": "HARD",
      "provenance": {
        "source_file": "tasks/jpg-ocr-stat/instruction.md",
        "source_type": "instruction",
        "line_start": 7,
        "line_end": 7,
        "exact_text": "The output file should only contain one sheet called \"results\". It should have 3 columns:\n",
        "source_sha256": "b665874712cbfe3d6d4a0058fee35e0cc33f0f714e10e865ab989cf959ef8939",
        "extraction_rule": "actionable_paragraph"
      }
    },
