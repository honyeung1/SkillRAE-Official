        "source_type": "instruction",
        "line_start": 8,
        "line_end": 8,
        "exact_text": "- `filename`: source filename (e.g., \"000.jpg\").\n",
        "source_sha256": "b665874712cbfe3d6d4a0058fee35e0cc33f0f714e10e865ab989cf959ef8939",
        "extraction_rule": "commonmark_list_item"
