{
  "task_id": "civ6-adjacency-optimizer",
  "top_k": 5,
  "requirements": [
    {
      "requirement_id": "req_9bf45c6f4a0730dbd88f",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "CORE",
      "provenance": {
        "source_file": "tasks/civ6-adjacency-optimizer/instruction.md",
        "source_type": "instruction",
        "line_start": 5,
        "line_end": 8,
        "exact_text": "Imagining you are acting as an optimizer for adjacency bonus in Sid Meier's Civilization 6.\nGiven a map scenario, place city center(s) and districts to maximize total adjacency bonuses.\nYou are responsible of understanding the spatial relationships of tiles on the map. Deciding which and how many districts you can place.\nAt the end, come up with placement solution that achieves the highest adjacency bonus and accurately calculate the bonus.\n",
        "source_sha256": "ba15e441239d66d31005e10e17d01749ad3a77af129afcb46dca800475cb910b",
        "extraction_rule": "actionable_paragraph"
      }
    },
    {
