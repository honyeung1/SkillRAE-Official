{
  "task_id": "spring-boot-jakarta-migration",
  "top_k": 5,
  "requirements": [
    {
      "requirement_id": "req_a7bda469f475cc9d6880",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "CORE",
      "provenance": {
        "source_file": "tasks/spring-boot-jakarta-migration/instruction.md",
        "source_type": "instruction",
        "line_start": 3,
        "line_end": 3,
        "exact_text": "You migration should upgrade Java version from 8 to 21, Spring Boot version from 2.7.x to 3.2.x and upgrade all related dependencies to compatible versions. Make sure the namespace migration are properly handled. You also need to ensure Hibernate 6 compatibility, update to Spring Security 6, migrate RestTemplate to RestClient, and fix deprecated security methods.\n",
        "source_sha256": "9e6eae81f5df0e642bdfff4a270685ae7603409c740883f5b4bc026593f34ae4",
        "extraction_rule": "actionable_paragraph"
      }
    },
    {
      "requirement_id": "req_64de603d59a0d6b12bea",
      "requirement_type": "VALIDATION",
      "criticality": "CORE",
      "provenance": {
        "source_file": "tasks/spring-boot-jakarta-migration/instruction.md",
        "source_type": "instruction",
        "line_start": 5,
        "line_end": 5,
        "exact_text": "Make sure to run the following commands to check the quality:\n",
        "source_sha256": "9e6eae81f5df0e642bdfff4a270685ae7603409c740883f5b4bc026593f34ae4",
        "extraction_rule": "actionable_paragraph"
      }
    },
    {
      "requirement_id": "req_2fb72320e0b4a70bc03a",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/spring-boot-jakarta-migration/instruction.md",
        "source_type": "instruction",
        "line_start": 7,
        "line_end": 7,
        "exact_text": "1. `mvn clean compile` (you code should not return errors)\n",
        "source_sha256": "9e6eae81f5df0e642bdfff4a270685ae7603409c740883f5b4bc026593f34ae4",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_293644fe3a1c704f053d",
      "requirement_type": "VALIDATION",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/spring-boot-jakarta-migration/instruction.md",
        "source_type": "instruction",
        "line_start": 8,
        "line_end": 8,
        "exact_text": "2. `mvn test` (your code need to pass all unit tests)\n",
        "source_sha256": "9e6eae81f5df0e642bdfff4a270685ae7603409c740883f5b4bc026593f34ae4",
        "extraction_rule": "commonmark_list_item"
