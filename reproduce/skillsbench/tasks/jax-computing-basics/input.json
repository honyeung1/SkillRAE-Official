{
  "task_id": "jax-computing-basics",
  "top_k": 5,
  "requirements": [
    {
      "requirement_id": "req_10586577f4b1fc481e91",
      "requirement_type": "OUTPUT_PATH",
      "criticality": "HARD",
      "provenance": {
        "source_file": "tasks/jax-computing-basics/instruction.md",
        "source_type": "instruction",
        "line_start": 1,
        "line_end": 1,
        "exact_text": "Given a set of tasks in \"problem.json\", complete all programming using JAX language correctly. For each task, read the input data, write JAX code to do some computation, then produce an output file and save it.\n",
        "source_sha256": "7b2803bada900b17865d7707e61fcfe3b666a10ca24bf75a0a26d94a5a7ead28",
        "extraction_rule": "actionable_paragraph"
      }
    },
    {
      "requirement_id": "req_2786c8b73ac69ad62ec7",
      "requirement_type": "FORMAT",
      "criticality": "SUPPORT",
      "provenance": {
        "source_file": "tasks/jax-computing-basics/instruction.md",
        "source_type": "instruction",
        "line_start": 3,
        "line_end": 3,
        "exact_text": "1. For each task, load the input data specified by the \"input\" key in \"problem.json\".\n",
        "source_sha256": "7b2803bada900b17865d7707e61fcfe3b666a10ca24bf75a0a26d94a5a7ead28",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_76255e025048314dc325",
      "requirement_type": "DOMAIN_ACTION",
      "criticality": "HARD",
      "provenance": {
        "source_file": "tasks/jax-computing-basics/instruction.md",
        "source_type": "instruction",
        "line_start": 4,
        "line_end": 4,
        "exact_text": "2. Perform the computation required by each task's \"description\" key:\n",
        "source_sha256": "7b2803bada900b17865d7707e61fcfe3b666a10ca24bf75a0a26d94a5a7ead28",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_b33020d9f6ee1a7231f4",
      "requirement_type": "OUTPUT_PATH",
      "criticality": "HARD",
      "provenance": {
        "source_file": "tasks/jax-computing-basics/instruction.md",
        "source_type": "instruction",
        "line_start": 5,
        "line_end": 6,
        "exact_text": "3. Save the computed outputs to the file specified by the \"output\" key in \"problem.json\".\n\n",
        "source_sha256": "7b2803bada900b17865d7707e61fcfe3b666a10ca24bf75a0a26d94a5a7ead28",
        "extraction_rule": "commonmark_list_item"
      }
    },
    {
      "requirement_id": "req_23c0cbe4a9c1987966c0",
      "requirement_type": "OUTPUT_PATH",
      "criticality": "HARD",
      "provenance": {
        "source_file": "tasks/jax-computing-basics/instruction.md",
        "source_type": "instruction",
        "line_start": 9,
        "line_end": 17,
        "exact_text": "[\n    {\n      \"id\": a unique problem id,\n      \"description\": a language description of the task,\n      \"input\": input data path, for example: \"data/x.npy\",\n      \"output\": output result path, for example: \"basic_reduce.npy\"\n    },\n    ...,\n]\n",
        "source_sha256": "7b2803bada900b17865d7707e61fcfe3b666a10ca24bf75a0a26d94a5a7ead28",
