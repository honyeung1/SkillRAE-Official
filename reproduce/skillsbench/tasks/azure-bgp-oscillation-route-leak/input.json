        "source_type": "instruction",
        "line_start": 10,
        "line_end": 10,
        "exact_text": "2. Detect in the topology: oscillation and/or route leak event violating BGP valley-free routing\n",
        "source_sha256": "2c8ed6df1fa497d911faf19f7752f4c865ecca571e5ccdc4b7ed5eb3deffd6ca",
        "extraction_rule": "commonmark_list_item"
